# 复制到仓库根目录：cp infra/docker/.env.example .env
# 然后修改密码后再启动。浏览器访问 http://服务器IP:WEB_PORT

WEB_PORT=8080

POSTGRES_USER=ainovel
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=ai_novel

# 打开网页前要输入的访问密码。留空则不启用登录墙。请改成只有你知道的密码。
ACCESS_PASSWORD=change-me-before-deploy

# 模型 API Key 建议启动后在网页「模型与厂商」里填写，不必写进这个文件。
RAG_ENABLED=false
DIRECTOR_NEXT_ENABLED=true
API_JSON_LIMIT=5mb
