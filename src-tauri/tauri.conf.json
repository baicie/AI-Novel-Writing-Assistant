{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biz Novel Studio",
  "version": "0.1.0",
  "identifier": "com.ai-novel.studio",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm exec concurrently \"pnpm dev:shared\" \"pnpm dev:server\" \"pnpm dev:client:wait\"",
    "beforeBuildCommand": "pnpm --filter @ai-novel/client build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset: data: blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Biz Novel Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/app-icon-32.png",
      "icons/app-icon-64.png",
      "icons/app-icon-128.png",
      "icons/app-icon-256.png",
      "icons/app-icon-512.png"
    ],
    "targets": ["dmg", "app"]
  }
}
